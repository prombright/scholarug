# Don't allow browsing folder contents (hides file listings/extensions)
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS site-wide. Must be the first rule -- it has to catch a
    # plain-HTTP request before any other rewrite touches it. %{HTTPS} is
    # set correctly here because cPanel/Apache terminates TLS directly
    # (no separate reverse proxy in front), so this alone is reliable
    # without also needing an X-Forwarded-Proto check. Skipped for
    # localhost specifically -- this same .htaccess is also what the
    # local XAMPP dev copy of this project uses, and XAMPP has no local
    # SSL cert, so this rule would otherwise redirect every local request
    # to an https:// URL nothing is listening on.
    RewriteCond %{HTTP_HOST} !=localhost
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # If a page is reached via its literal .php URL (GET/HEAD only — leaves
    # POST form submissions like login/upload forms untouched so they don't
    # lose their data), send the browser to the clean extensionless URL.
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s/+(.+)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Serve the matching .php file for a clean extensionless URL, without
    # changing what's shown in the address bar.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>

# Gzip compression for text-based assets
<IfModule mod_deflate.c>
    <FilesMatch "\.(html|htm|php|css|js|json|xml|svg)$">
        SetOutputFilter DEFLATE
    </FilesMatch>
</IfModule>

# Browser caching for static assets. Images get a full year (they're
# stable assets that get replaced by filename when they change, same as
# any static site); CSS/JS also get a full year since includes/head.php's
# style.css link is cache-busted with a filemtime() version query string,
# so a real edit is served immediately regardless of this expiry -- there
# used to be no such cache-busting, which is why these were kept short
# (1 week) before. Fonts added for when/if any get self-hosted later.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico|css|js|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>

    # Tell browsers to remember this site is HTTPS-only for a year, so
    # even a typed/bookmarked http:// link upgrades before it ever leaves
    # the browser -- the mod_rewrite redirect above still catches the
    # first visit, this covers every visit after it. Deliberately NOT
    # includeSubDomains -- that would also force HTTPS on mail./webmail.
    # etc, which haven't been verified to always serve valid HTTPS.
    Header always set Strict-Transport-Security "max-age=31536000"

    # Baseline hardening headers -- no functional risk to this site (no
    # third-party framing, no MIME-sniffable uploads served as scripts).
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
