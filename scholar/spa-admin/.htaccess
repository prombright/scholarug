# Vite/Vue SOURCE tree for the admin SPA pilot -- never meant to be
# web-served. The served build lives under scholar/assets/spa-admin/ (see
# app_admin.php). See scholar/spa/.htaccess for the full rationale.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
