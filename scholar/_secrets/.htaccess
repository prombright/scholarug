# Blocks direct HTTP access to the local libsodium fallback key
# (credential.key) that ScholarSecrets.php generates when SCHOLAR_CREDENTIAL_KEY
# isn't set in the environment. Without this, anyone who requests this path
# directly could download the key that decrypts every stored WhatsApp
# access token. Same pattern as _setup/.htaccess.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
